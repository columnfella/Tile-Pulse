# The game app (Expo: phone + web)
node_modules/
dist/
.expo/
expo-env.d.ts
.env*
!.env.example

# Native folders are generated by 'expo prebuild' (on EAS Build); never committed.
# (They must stay ignored: the runtime fingerprint treats a committed android/
# folder as a bare project and the build would no longer match OTA updates.)
/android
/ios
