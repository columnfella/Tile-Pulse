{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "npm ci",
  "buildCommand": "npx expo export --platform web",
  "ignoreCommand": "git diff HEAD^ HEAD --quiet -- . ':(exclude)eas.json' ':(exclude)fingerprint.config.js' ':(exclude)scripts/enable-ios.js' ':(exclude)docs/**' ':(exclude)**/*.native.ts' ':(exclude)**/*.native.tsx' ':(exclude)**/*.android.ts' ':(exclude)**/*.android.tsx' ':(exclude)**/*.ios.ts' ':(exclude)**/*.ios.tsx'",
  "outputDirectory": "dist",
  "framework": null,
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/_expo/static/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ]
}
