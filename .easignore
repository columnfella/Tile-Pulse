# Files left out of EAS Build uploads. EAS packs the repository from its ROOT
# (where this file must live) and builds the app in game/. When this file
# exists EAS uses it instead of the .gitignore files, so their rules are
# repeated here.
node_modules/
build/
dist/
coverage/
.DS_Store
*.log
.env*
!.env.example
expo-env.d.ts
.expo/

# Not part of the app: the server, the website, the admin console, CI config
# and repo tooling stay off the build servers
/backend/
/admin-console/
/website/
/.github/
/.githooks/
/scripts/
/game/docs/
/game/scripts/

# Native folders are generated by prebuild on the build server
/game/android
/game/ios
