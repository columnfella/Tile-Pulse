{
  "expo": {
    "name": "TilePulse",
    "slug": "tilepulse-rhythm-game",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#030712"
    },
    "scheme": "tilepulse",
    "plugins": [
      "expo-router",
      "expo-audio",
      "expo-document-picker",
      "expo-status-bar",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#030712",
          "imageWidth": 120
        }
      ],
      [
        "expo-media-library",
        {
          "granularPermissions": ["audio"],
          "isAccessMediaLocationEnabled": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.tilepulse.rhythm"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#030712"
      },
      "package": "com.tilepulse.rhythm"
    },
    "web": {
      "bundler": "metro"
    }
  }
}
